## TE0725 Artix-7 S-100 client-card constraints.
## All S-100-facing FPGA banks are powered at 3.3 V.
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]

set_property -dict {PACKAGE_PIN P17 IOSTANDARD LVCMOS33} [get_ports clk_100mhz]
create_clock -name clk_100mhz -period 10.000 [get_ports clk_100mhz]
set_property -dict {PACKAGE_PIN M16 IOSTANDARD LVCMOS33} [get_ports led]

## J3: S-100 address and cycle inputs.
set_property -dict {PACKAGE_PIN T8 IOSTANDARD LVCMOS33} [get_ports {f_a[0]}]
set_property -dict {PACKAGE_PIN R8 IOSTANDARD LVCMOS33} [get_ports {f_a[1]}]
set_property -dict {PACKAGE_PIN V9 IOSTANDARD LVCMOS33} [get_ports {f_a[2]}]
set_property -dict {PACKAGE_PIN U9 IOSTANDARD LVCMOS33} [get_ports {f_a[3]}]
set_property -dict {PACKAGE_PIN N6 IOSTANDARD LVCMOS33} [get_ports {f_a[4]}]
set_property -dict {PACKAGE_PIN M6 IOSTANDARD LVCMOS33} [get_ports {f_a[5]}]
set_property -dict {PACKAGE_PIN U6 IOSTANDARD LVCMOS33} [get_ports {f_a[6]}]
set_property -dict {PACKAGE_PIN U7 IOSTANDARD LVCMOS33} [get_ports {f_a[7]}]
set_property -dict {PACKAGE_PIN V6 IOSTANDARD LVCMOS33} [get_ports {f_a[8]}]
set_property -dict {PACKAGE_PIN V7 IOSTANDARD LVCMOS33} [get_ports {f_a[9]}]
set_property -dict {PACKAGE_PIN T6 IOSTANDARD LVCMOS33} [get_ports {f_a[10]}]
set_property -dict {PACKAGE_PIN R7 IOSTANDARD LVCMOS33} [get_ports {f_a[11]}]
set_property -dict {PACKAGE_PIN V4 IOSTANDARD LVCMOS33} [get_ports {f_a[12]}]
set_property -dict {PACKAGE_PIN V5 IOSTANDARD LVCMOS33} [get_ports {f_a[13]}]
set_property -dict {PACKAGE_PIN R6 IOSTANDARD LVCMOS33} [get_ports {f_a[14]}]
set_property -dict {PACKAGE_PIN R5 IOSTANDARD LVCMOS33} [get_ports {f_a[15]}]
set_property -dict {PACKAGE_PIN U4 IOSTANDARD LVCMOS33} [get_ports {f_a[16]}]
set_property -dict {PACKAGE_PIN U3 IOSTANDARD LVCMOS33} [get_ports {f_a[17]}]
set_property -dict {PACKAGE_PIN V2 IOSTANDARD LVCMOS33} [get_ports {f_a[18]}]
set_property -dict {PACKAGE_PIN U2 IOSTANDARD LVCMOS33} [get_ports {f_a[19]}]
set_property -dict {PACKAGE_PIN V1 IOSTANDARD LVCMOS33} [get_ports {f_a[20]}]
set_property -dict {PACKAGE_PIN U1 IOSTANDARD LVCMOS33} [get_ports {f_a[21]}]
set_property -dict {PACKAGE_PIN N5 IOSTANDARD LVCMOS33} [get_ports {f_a[22]}]
set_property -dict {PACKAGE_PIN P5 IOSTANDARD LVCMOS33} [get_ports {f_a[23]}]
set_property -dict {PACKAGE_PIN M4 IOSTANDARD LVCMOS33} [get_ports f_pdbin]
set_property -dict {PACKAGE_PIN T1 IOSTANDARD LVCMOS33} [get_ports f_pwr_n]
set_property -dict {PACKAGE_PIN N1 IOSTANDARD LVCMOS33} [get_ports f_smemr]
set_property -dict {PACKAGE_PIN R2 IOSTANDARD LVCMOS33} [get_ports f_sout]

## J4: FPGA data pins are shared by a DO receiver and a tri-state DI driver.
set_property -dict {PACKAGE_PIN K1 IOSTANDARD LVCMOS33} [get_ports {f_d[0]}]
set_property -dict {PACKAGE_PIN K2 IOSTANDARD LVCMOS33} [get_ports {f_d[1]}]
set_property -dict {PACKAGE_PIN G2 IOSTANDARD LVCMOS33} [get_ports {f_d[2]}]
set_property -dict {PACKAGE_PIN H2 IOSTANDARD LVCMOS33} [get_ports {f_d[3]}]
set_property -dict {PACKAGE_PIN F3 IOSTANDARD LVCMOS33} [get_ports {f_d[4]}]
set_property -dict {PACKAGE_PIN F4 IOSTANDARD LVCMOS33} [get_ports {f_d[5]}]
set_property -dict {PACKAGE_PIN D3 IOSTANDARD LVCMOS33} [get_ports {f_d[6]}]
set_property -dict {PACKAGE_PIN E3 IOSTANDARD LVCMOS33} [get_ports {f_d[7]}]
set_property -dict {PACKAGE_PIN C5 IOSTANDARD LVCMOS33 PULLUP true} [get_ports f_reset_n]
set_property -dict {PACKAGE_PIN E5 IOSTANDARD LVCMOS33 PULLUP true} [get_ports f_poc_n]
set_property -dict {PACKAGE_PIN E7 IOSTANDARD LVCMOS33} [get_ports ls_di_oe_n]
set_property -dict {PACKAGE_PIN G6 IOSTANDARD LVCMOS33} [get_ports ls_do_oe_n]

## The S-100 bus is asynchronous to the TE0725 oscillator.
set_false_path -from [get_ports {f_*}] -to [all_registers]
set_false_path -from [all_registers] -to [get_ports {f_d ls_*}]
