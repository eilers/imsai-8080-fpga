				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7f1a17f2-2e88-4823-af6f-fa20a20ca18d")
	)
(text "U5  A0-A7"
		(exclude_from_sim no)
		(at 28 34 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
