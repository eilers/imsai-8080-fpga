	(text "Feedback: 100k over 13.3k gives 5.08 V. 100k over 22.1k gives 3.29 V. Reference is 0.596 V."
		(exclude_from_sim no)
		(at 14.478 21.844 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "314147b3-48fe-4746-acbc-7a6900b98f79")
	)
	(text "On-card regulators, from the S-100 +8 V rail (pins 1 and 51) to ground (pins 50 and 100)."
		(exclude_from_sim no)
		(at 14.478 14.224 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4dfd9fa1-7bc2-4d4e-9732-b2af83507c3b")
	)
	(text "U1 makes +5 V. U2 makes +3.3 V. Each TPS54302 is a synchronous buck, 4.5 V to 28 V in, 400 kHz."
		(exclude_from_sim no)
		(at 14.478 16.764 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4fe433fc-05ca-4b45-8fa2-bbf8011a67da")
	)
	(text "Place the input capacitors next to each regulator and keep the switch node short on the board."
		(exclude_from_sim no)
		(at 14.478 24.384 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "787dfa16-56fd-4793-a4bf-75749c87621a")
	)
	(text "Passives are through-hole. U1 and U2 stay in SOT-23-6 and should stay at or below about 2 A. F1 holds 2.5 A."
		(exclude_from_sim no)
		(at 14.478 19.304 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b7358dde-f0c2-4810-b7bf-b29c83948eb8")
	)
