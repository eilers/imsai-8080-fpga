	(text "On-card regulators, from the S-100 +8 V rail (pins 1 and 51) to ground (pins 50 and 100)."
		(exclude_from_sim no)
		(at 15.494 16.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2994f85b-db0b-437c-972d-fd07d08b8101")
	)
	(text "Feedback: 100k over 13.3k gives 5.08 V. 100k over 22.1k gives 3.29 V. Reference is 0.596 V."
		(exclude_from_sim no)
		(at 15.494 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "33b6253d-3322-4e44-bc62-87e09be05564")
	)
	(text "Place the input capacitors next to each regulator and keep the switch node short on the board."
		(exclude_from_sim no)
		(at 15.494 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6dd60222-8f9f-439f-a814-5928f85cb332")
	)
	(text "U1 makes +5 V. U2 makes +3.3 V. Each TPS54302 is a synchronous buck, 4.5 V to 28 V in, 400 kHz."
		(exclude_from_sim no)
		(at 15.494 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "972100d8-eacf-458b-b9d0-c3a152e81083")
	)
	(text "Passives are through-hole. U1 and U2 stay in SOT-23-6 and should stay at or below about 2 A. F1 holds 2.5 A."
		(exclude_from_sim no)
		(at 15.494 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bdb9010f-d951-4f11-998d-73bc54a60fe7")
	)
