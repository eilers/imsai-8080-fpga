		)
	)
	(text "5 V and 3.3 V from the S-100 unregulated +8 V. U1 is a 7805. U2 is an LM1117T-3.3 fed from the 5 V rail. Both are TO-220. Fit a small heatsink on U1."
		(exclude_from_sim no)
		(at 20 25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f5f4ba41-8c06-4401-a3e5-ecf5d303acdb")
	)
	(text "The S-100 +8 V rail must stay above about 7.5 V, because a 7805 needs roughly 2 V of headroom."
		(exclude_from_sim no)
		(at 20 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "360f9097-8aa2-4b09-b75a-c2133bb32698")
